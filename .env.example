API_URL=http://localhost:8080

# Login con Google (staff): crea credenciales OAuth 2.0 "Aplicación web" en
# https://console.cloud.google.com/apis/credentials, añade este origen
# (http://localhost:3000 en dev) a "Orígenes de JavaScript autorizados",
# y pega aquí el Client ID. El Client Secret NO hace falta en el frontend
# (solo verificamos el id_token), pero el backend necesita la misma
# variable como GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
